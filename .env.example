# development | production | test (por defecto development).
# En production se desactiva synchronize de TypeORM.
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Obligatoria, mínimo 32 caracteres (p. ej. `openssl rand -hex 32`)
JWT_SECRET=
# Orígenes del frontend permitidos por CORS, separados por comas.
# Vacío: en development se permite cualquiera; en production, ninguno.
CORS_ORIGINS=
# Número de proxies inversos delante de la API (0 si se accede directamente)
TRUST_PROXY=0

# --- Solo para Docker (docker compose) ---
# Puertos publicados en tu máquina (opcionales)
API_PORT_HOST=3000
DB_PORT_HOST=5433
# Usuario de Docker Hub: nombre de la imagen <usuario>/activebreak-backend:latest
DOCKERHUB_USUARIO=
