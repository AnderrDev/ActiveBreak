# development | production | test (default development).
# In production TypeORM synchronize is disabled (tables come from database/init).
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Required, at least 32 characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Frontend origins allowed by CORS, separated by commas (e.g. http://localhost:4200).
# Empty: any origin in development; none in production.
CORS_ORIGINS=
# Number of reverse proxies in front of the API (0 for direct access)
TRUST_PROXY=0
# Publishes the Swagger documentation at /api/docs (true/false)
API_DOCS_ENABLED=true
# Time zone used for "today" in the goals (Colombia)
TZ=America/Bogota

# --- Docker only (docker compose) ---
# Ports published on your machine (optional)
API_PORT_HOST=3000
DB_PORT_HOST=5433
# Backend image. Empty: local name (activebreak-backend:local).
# For the automatic deployment: <dockerhub-user>/activebreak-backend:latest
BACKEND_IMAGE=
