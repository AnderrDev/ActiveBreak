# development | production | test (por defecto development).
# En production se desactiva synchronize de TypeORM.
NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
# Obligatoria, mínimo 32 caracteres (p. ej. `openssl rand -hex 32`)
JWT_SECRET=

# --- Solo para Docker (docker compose) ---
# Puertos expuestos en tu máquina (opcionales)
API_PORT_HOST=3000
DB_PORT_HOST=5433

# Solo para docker compose (opcionales): puertos publicados en el host
# DB_PORT_HOST=5433
# API_PORT_HOST=3000
